from pathlib import Path
import os



def createfile():
    try:
        name = input("Please tell the file name you want to create :- ")
        path = Path(name)
        if not path.exists():
            with open(path,"w") as fs:
                data = input("What do you want to write in the file :-")
                fs.write(data)
                print("File created Successfully!")
        else:
            print("Error File name already exists")

    except Exception as err:
        print(f"An error occured as {err}")

def readfile():
    try:
        name = input("Tell the name of file you want to read :-")
        path = Path(name)
        if path.exists():
            with open(path,"r") as fs:
                content = fs.read()
                print(f"Your file content is :- \n {content}")
        else:
            print("No file with this name exists!")
    except Exception as err:
        print(f"Sorry an error occurred as {err}")
        
def updatefile():
    try:
        name = input("Enter the name of the file you want to update :-")
        path = Path(name)

        if path.exists():
            print("Operations you can perform on this file :-")
            print("1. Rename the file")
            print("2. Append the content of the file")
            print("3. Overwriting the file")

            choice = int(input("Tell me your choice:-"))

            if choice == 1:
                new_name = input("Enter the new name :-")
                new_path = Path(new_name)
                if not new_path.exists():
                    path.rename(new_path)
                    print("Renamed")
                else:
                    print("File with this name already exists")

            elif choice == 2:
                with open(name,"a") as fs:
                    data = input("Enter the content you want to append")
                    fs.write("\n " + data)
                    print("Successfully Appended")

            elif choice == 3:
                with open(path,"w") as fs:
                    data = input("Enter the content you want to overwrite :-")
                    fs.write(data)
                    print("Successfully Overwrite!")
            
    except Exception as err:
        print(f"Sorry an error occured as {err}")
                
def deletefile():
    try:
        name = input("Enter the file name you want to delete :-")
        path = Path(name)

        if path.exists():
            path.unlink()
            print("Successfully deleted!")
        else:
            print("No file with such name exists.")

    except Exception as err:
        print(f"An error occured as {err}")



